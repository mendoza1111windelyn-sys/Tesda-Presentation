# One-time code used to set the presenter passcode on first visit. Once set,
# the chosen passcode is stored as a salted hash in Supabase/local data.
PRESENTER_PASSCODE=replace-with-a-long-random-setup-code
# Optional: set both values to persist files and the presentation library in Supabase.
# Keep the server-only key private; never add it to client code or commit it.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret-key
# SUPABASE_BUCKET=presentations
# Optional local-only storage directory when Supabase is not configured.
# DATA_DIR=./data
PORT=3001
